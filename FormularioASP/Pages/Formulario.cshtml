@page

<style>
    header {
        display: none !important;
    }

    footer {
        display: none !important;
    }
</style>

@inject IConfiguration Configuration

@model FormularioASP.Pages.FormularioModel
@{
    ViewData["Title"] = "Formulario de Alta";
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="
        background: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
        padding: 10px 15px;
        border-radius: 5px;
        margin-bottom: 15px;
        font-weight: bold;">
        @TempData["SuccessMessage"]
    </div>
}

<div class="container mt-4">

    <form method="post" enctype="multipart/form-data">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <!-- BANNER -->
        <style>  
                    header, footer {
                        display: none !important;
                    }
                    
                    .banner-registro {
                        width: 100%;
                        background-color: #a672c2;
                        color: white;
                        padding: 30px 40px;
                        display: flex;
                        align-items: center;
                        gap: 30px;
                        box-sizing: border-box;
                    }

                        .banner-registro img {
                            height: 160px;
                        }

                    .banner-texto {
                        flex: 1;
                    }

                    .banner-titulo {
                        font-size: 32px;
                        font-weight: bold;
                        margin-bottom: 10px;
                        border-bottom: 4px solid white;
                        padding-bottom: 5px;
                        width: fit-content;
                    }

                    .banner-descripcion {
                        font-size: 18px;
                        line-height: 1.4;
                        margin-top: 10px;
                    }
        </style>
        
        <div class="banner-registro">
            <img src="/images/torreShield.png" alt="Logo" />

            <div class="banner-texto">
                <div class="banner-titulo">REGISTRO DEMANDANTES</div>

                <div class="banner-descripcion">
                    Para darte de alta en la Bolsa de Empleo OnLine, deberás completar los siguientes datos en su totalidad.<br /><br />
                    Obligatorio adjuntar Curriculum Vitae que contenga de forma detallada su historial profesional y formativo, y su conocimiento de idiomas.
                </div>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" style="margin-bottom:20px;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <br />
        <br />

        <!-- DATOS ACCESO -->
        <fieldset class="p-3" style="border: 2px solid #c89de0;">
            <legend class="w-auto" style="font-weight:bold; text-decoration:underline;">DATOS DE ACCESO</legend>

            <input asp-for="Documento"
                   id="Documento"
                   class="form-control mb-2 obligatorio"
                   placeholder="NIF/NIE/PASAPORTE" />
        </fieldset>

        <br />

        <!-- DATOS PERSONALES -->
        <fieldset class="p-3" style="border: 2px solid #c89de0;">
            <legend class="w-auto" style="font-weight:bold; text-decoration:underline;">DATOS PERSONALES</legend>

            <!-- NOMBRE -->
            <input id="Nombre" name="Nombre" class="form-control mb-2 obligatorio" placeholder="Nombre" />
            <input id="Apellido1" name="Apellido1" class="form-control mb-2 obligatorio" placeholder="Primer Apellido" />
            <input id="Apellido2" name="Apellido2" class="form-control mb-2 obligatorio" placeholder="Segundo Apellido" />

            <br />

            <!-- FECHA NACIMIENTO -->
            <label class="fw-bold">Fecha de nacimiento:</label>
            <input asp-for="FechaNacimiento" id="FechaNacimiento" name="FechaNacimiento" class="form-control mb-2 obligatorio" placeholder="dd/MM/yyyy" />

            <br />

            <!-- SEXO -->
            <label class="fw-bold">Sexo:</label>
            <div class="d-flex gap-3 mb-2 obligatorio" id="SexoGrupo">
                <label><input type="radio" name="sexo" value="Hombre" /> Hombre</label>
                <label><input type="radio" name="sexo" value="Mujer" /> Mujer</label>
            </div>

            <br />

            <!-- DOMICILIO -->
            <div class="row mb-2">
                <label class="fw-bold">Dirección:</label>

                <div class="col-6">
                    <input id="Calle" name="Calle" class="form-control obligatorio" placeholder="Calle. Ej: Cristo 6" />
                </div>

                <div class="col-3">
                    <input id="Piso" name="Piso" class="form-control obligatorio" placeholder="Piso. Ej: 7" />
                </div>

                <div class="col-3">
                    <input id="Puerta" name="Puerta" class="form-control obligatorio" placeholder="Puerta. Ej: D" />
                </div>
            </div>

            <select class="form-select mb-2" name="Poblacion">
                <option>TORREJÓN DE ARDOZ</option>
            </select>

            <br />

            <!-- TELEFONO PRINCIPAL -->
            <label class="fw-bold">Teléfono principal:</label>
            <div class="mb-2">
                <input id="Telefono1" name="Telefono1" class="form-control obligatorio" placeholder="XXX XX XX XX" />
            </div>

            <!-- TELEFONO SECUNDARIO -->
            <label class="fw-bold">Teléfono secundario:</label>
            <div class="mb-2">
                <input id="Telefono2" name="Telefono2" class="form-control" placeholder="XXX XX XX XX" />
            </div>

            <br />

            <!-- CORREO -->
            <label class="fw-bold">Correo:</label>
            <input id="Email" name="Email" class="form-control mb-2" placeholder="Email" />

            <br />

            <!-- NACIONALIDAD -->
            <label class="fw-bold">Nacionalidad:</label>
            <select class="form-select mb-2" name="Nacionalidad">
                @foreach (var nac in Model.Nacionalidades)
                {
                    <option value="@nac.nClave">@nac.sDescripcion</option>
                }
            </select>

            <br />

            <!-- FECHA DEMANDA -->
            <label class="fw-bold">Fecha de demandante de empleo:</label>
            <input asp-for="FechaDemanda" id="FechaDemanda" name="FechaDemanda" class="form-control mb-2 obligatorio" placeholder="dd/MM/yyyy" />

            <br />

            <!-- ESTA DESEMPLEADO -->
            <label class="fw-bold">¿Estás desempleado?</label>
            <div class="d-flex gap-3 mb-2 obligatorio" id="DesempleoGrupo">
                <label><input type="radio" name="desempleo" value="Sí" /> Sí</label>
                <label><input type="radio" name="desempleo" value="No" /> No</label>
            </div>

            <br />

            <!-- MEJORA DE EMPLEO -->
            <label class="fw-bold">¿Estás en mejora de empleo?</label>
            <div class="d-flex gap-3 mb-2 obligatorio" id="MejoraGrupo">
                <label><input type="radio" name="mejora" value="Sí" /> Sí</label>
                <label><input type="radio" name="mejora" value="No" /> No</label>
            </div>
        </fieldset>

        <br />

        <!-- DISCAPACIDAD -->
        <fieldset class="p-3" style="border: 2px solid #c89de0;">
            <legend class="w-auto" style="font-weight:bold; text-decoration:underline;">DISCAPACIDAD RECONOCIDA</legend>

            <p class="text-muted">Solo marcar si la discapacidad es igual o mayor del 33%</p>

            <div class="row">
                <div class="col-4"><input type="checkbox" name="DFisica" value="1" /> Física</div>
                <div class="col-4"><input type="checkbox" name="DPsiquica" value="1" /> Psíquica</div>
                <div class="col-4"><input type="checkbox" name="DSensorial" value="1" /> Sensorial</div>
            </div>
        </fieldset>

        <br />

        <!-- TIPOS DE CARNET -->
        <fieldset class="p-3" style="border: 2px solid #c89de0;">
            <legend class="w-auto" style="font-weight:bold; text-decoration:underline;">TIPOS DE CARNETS</legend>

            <div class="row row-cols-3">
                <div class="col"><input type="checkbox" name="permisos" value="2" /> A</div>
                <div class="col"><input type="checkbox" name="permisos" value="1" /> A1</div>
                <div class="col"><input type="checkbox" name="permisos" value="14" /> ADR</div>
                <div class="col"><input type="checkbox" name="permisos" value="12" /> Autorización BTP</div>
                <div class="col"><input type="checkbox" name="permisos" value="3" /> B</div>
                <div class="col"><input type="checkbox" name="permisos" value="4" /> B+E</div>
                <div class="col"><input type="checkbox" name="permisos" value="7" /> C</div>
                <div class="col"><input type="checkbox" name="permisos" value="8" /> C+E</div>
                <div class="col"><input type="checkbox" name="permisos" value="5" /> C1</div>
                <div class="col"><input type="checkbox" name="permisos" value="6" /> C1+E</div>
                <div class="col"><input type="checkbox" name="permisos" value="15" /> CAP</div>
                <div class="col"><input type="checkbox" name="permisos" value="17" /> Carretillero</div>
                <div class="col"><input type="checkbox" name="permisos" value="11" /> D</div>
                <div class="col"><input type="checkbox" name="permisos" value="10" /> D1+E</div>
                <div class="col"><input type="checkbox" name="permisos" value="16" /> Internacional</div>
                <div class="col"><input type="checkbox" name="permisos" value="13" /> Tarjeta tacógrafo</div>
            </div>
        </fieldset>

        <br />

        <!-- ESTILOS PICKER TRABAJOS -->
        <style>
                    .puesto-row select {
                        font-size: 16px;
                        padding: 4px 6px;
                        height: 30px;
                        width: 100%;
                        max-width: 100%;
                        box-sizing: border-box;
                        
                        overflow: hidden;
                        white-space: nowrap;
                        text-overflow: ellipsis;
                    }

                        .puesto-row select option {
                            font-size: 16px;
                            white-space: nowrap;
                            overflow: hidden;
                            text-overflow: ellipsis;
                        }
        </style>

        <!-- PUESTOS SOLICITADOS -->
        <fieldset class="p-3" style="border: 2px solid #c89de0;">
            <legend class="w-auto" style="font-weight:bold; text-decoration:underline;">
                PUESTOS SOLICITADOS
                <a href="https://bolsaempleo.ayto-torrejon.es/" target="_blank" class="ms-2" style="color:#c89de0; font-weight:bold;">
                    (consultar listado)
                </a>
            </legend>

            <div class="row mb-2">
                <div class="col-6"><label class="fw-bold">CATEGORÍA</label></div>
                <div class="col-6"><label class="fw-bold">PUESTO DE TRABAJO</label></div>
            </div>

            <div id="contenedor-puestos">

                <div class="row mb-3 puesto-row">
                    <div class="col-6">
                        <select class="categoria-picker" name="Categoria[]">
                            <option value="">Seleccione una categoría</option>
                            @foreach (var cat in Model.Categorias)
                            {
                                <option value="@cat.ID">@cat.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="col-6">
                        <select class="puesto-picker" name="Profesion[]">
                            <option value="">Seleccione un puesto</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="button" id="btnAñadir" class="btn"
                        style="background-color:#c89de0; border-color:#c89de0; color:white;">
                    Añadir
                </button>

                <button type="button" id="btnEliminar" class="btn ms-2"
                        style="background-color:#d3d3d3; border-color:#d3d3d3; color:black;">
                    Eliminar
                </button>
            </div>
        </fieldset>

        <br />

        <!-- CV -->
        <h4>CURRICULUM</h4>

        <input type="file" asp-for="ArchivoCV" class="form-control mb-2 obligatorio" />

        @if (Model.ArchivoNombre != null)
        {
            <p class="text-success fst-italic">Archivo "@Model.ArchivoNombre" añadido correctamente.</p>
        }

        <br />

        <!-- POLITICA -->
        <div id="PoliticaContainer" class="d-flex gap-2 mb-3">
            <input type="checkbox" asp-for="PoliticaAceptada" id="PoliticaAceptada" name="PoliticaAceptada" />
            <label>
                He leído la
                <a href="#" class="text-decoration-underline"
                       onclick="mostrarHola(); return false;"
                       style="color:#c89de0;">
                    política de privacidad
                </a>
            </label>
        </div>

        <p id="PoliticaError" style="color:#d9534f; display:none; font-weight:bold;">
            Debes aceptar la política de privacidad.
        </p>

        <!-- CAPTCHA -->
        <div id="CaptchaContainer">
            <div class="g-recaptcha" data-sitekey="@Configuration["GoogleReCaptcha:SiteKey"]"></div>
        </div>

        <p id="CaptchaError" style="color:#d9534f; display:none; font-weight:bold;">
            Debes verificar que no eres un robot.
        </p>

        <br />

        <!-- BOTONES FINALES-->
        <div class="d-flex gap-3 justify-content-center">
            <button id="btnEnviar" class="btn btn-primary" asp-page-handler="Enviar"
                    style="background-color:#c89de0; border-color:#c89de0;">
                Dar de alta
            </button>

            <button class="btn btn-secondary" asp-page-handler="Cancelar">Cancelar</button>
        </div>
    </form>

    <!-- MODAL POLITICA EMERGENTE -->
    <div class="modal fade" id="holaModal" tabindex="-1" aria-labelledby="holaLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="holaLabel">Mensaje</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body" style="line-height: 1.6; font-size: 15px;">

                    <h5 class="fw-bold mb-3" style="text-decoration: underline;">
                        Información de protección de datos de carácter personal
                    </h5>

                    <p>
                        <strong>Quién es el responsable del tratamiento:</strong><br>
                        Ayuntamiento de Torrejón de Ardoz – Plaza Mayor, 1 – 28850 Torrejón de Ardoz.<br>
                        Teléfono: 91 678 95 00.<br>
                        Puede contactar con la Delegada de Protección de Datos en
                        <a href="mailto:dpd@ayto-torrejon.es">dpd@ayto-torrejon.es</a>.
                    </p>

                    <p>
                        <strong>Con qué finalidad:</strong><br>
                        Llevar a cabo la gestión de búsqueda de empleo y favorecer el contacto entre empresas
                        y demandantes de empleo.
                    </p>

                    <p>
                        <strong>Por qué puede hacerlo:</strong><br>
                        Porque al entregar la ficha de inscripción solicitando el alta en la Bolsa de Empleo
                        nos da su consentimiento para ello.
                    </p>

                    <p>
                        <strong>Quién más accede a tus datos:</strong><br>
                        Empresas que se pongan en contacto con la Oficina Municipal de Empleo para posibles
                        incorporaciones, siempre y cuando su perfil se ajuste al que la empresa esté solicitando.
                    </p>

                    <p>
                        <strong>Qué derechos tienes y dónde ejercitarlos:</strong><br>
                        Acceso, rectificación, supresión, oposición, limitación del tratamiento y revocación
                        del consentimiento, presentando un escrito acompañado de una copia de su documento de
                        identidad dirigido a la Concejalía de Administración ante la oficina de Registro
                        presencial o virtual, o a través de la Sede Electrónica del Ayuntamiento.<br>
                        También puede presentar una reclamación ante la Agencia Española de Protección de Datos (AEPD).
                    </p>

                    <p>
                        <strong>Más información:</strong><br>
                        En la página web del Ayuntamiento:
                        <a href="https://www.ayto-torrejon.es" target="_blank">www.ayto-torrejon.es</a>.
                    </p>

                </div>


                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script>
            //SCRIPT VALIDACION
            document.getElementById("btnEnviar").addEventListener("click", function (e) {
                let campos = document.querySelectorAll(".obligatorio");
                let hayErrores = false;

                campos.forEach(campo => {
                    campo.classList.remove("campo-error");

                    if (campo.querySelectorAll("input[type=radio]").length > 0) {
                        const radios = campo.querySelectorAll("input[type=radio]");
                        const algunoMarcado = [...radios].some(r => r.checked);

                        if (!algunoMarcado) {
                            campo.classList.add("campo-error");
                            hayErrores = true;
                        }
                        return;
                    }

                    if (!campo.value || campo.value.trim() === "") {
                        campo.classList.add("campo-error");
                        hayErrores = true;
                    }
                });

                const captchaResponse = document.querySelector('textarea[name="g-recaptcha-response"]')?.value;
                const captchaContainer = document.getElementById("CaptchaContainer");
                const captchaError = document.getElementById("CaptchaError");

                if (!captchaResponse || captchaResponse.trim() === "") {
                    captchaContainer.classList.add("campo-error");
                    captchaError.style.display = "block";
                    hayErrores = true;
                } else {
                    captchaContainer.classList.remove("campo-error");
                    captchaError.style.display = "none";
                }

                const politica = document.getElementById("PoliticaAceptada");
                const politicaContainer = document.getElementById("PoliticaContainer");
                const politicaError = document.getElementById("PoliticaError");

                if (!politica.checked) {
                    politicaContainer.classList.add("campo-error");
                    politicaError.style.display = "block";
                    hayErrores = true;
                } else {
                    politicaContainer.classList.remove("campo-error");
                    politicaError.style.display = "none";
                }

                if (hayErrores) {
                    e.preventDefault();
                    alert("Faltan campos obligatorios por rellenar.");
                }
            });
    </script>

    <script>
        // SCRIPT MODAL POLITICA
            function mostrarHola() {
                var modal = new bootstrap.Modal(document.getElementById('holaModal'));
                modal.show();
            }
    </script>

    <script>
            // VALIDAR DNI
            function validarDNI(dni) {
                const letras = "TRWAGMYFPDXBNJZSQVHLCKE";
                const regex = /^[0-9]{8}[A-Za-z]$/;

                if (!regex.test(dni)) return false;

                const numero = parseInt(dni.substring(0, 8), 10);
                const letra = dni.charAt(8).toUpperCase();
                const letraCorrecta = letras[numero % 23];

                return letra === letraCorrecta;
            }

            //VALIDACION AL ENVIAR FORMULARIO
            document.querySelector("form").addEventListener("submit", function (e) {
                const doc = document.getElementById("Documento").value.trim().toUpperCase();

                const esDNI = validarDNI(doc);

                if (!esDNI) {
                    e.preventDefault();
                    alert("El documento introducido no es un DNI válido.");
                }
            });
    </script>

    <script>
            // VALIDAR FECHAS (NACIMIENTO Y DEMANDA)
            function configurarFecha(idCampo, validarEdad) {
                const input = document.getElementById(idCampo);

                input.addEventListener("input", function () {

                    const oldValue = input.getAttribute("data-old") || "";
                    const newValue = input.value;

                    const borrando = newValue.length < oldValue.length;

                    input.setAttribute("data-old", newValue);

                    if (borrando) {
                        input.style.color = "red";
                        return;
                    }

                    let valor = newValue.replace(/\D/g, "");

                    if (valor.length > 8)
                        valor = valor.substring(0, 8);

                    if (valor.length >= 4) {
                        valor = valor.substring(0, 2) + "/" +
                                valor.substring(2, 4) + "/" +
                                valor.substring(4);
                    }
                    else if (valor.length >= 2) {
                        valor = valor.substring(0, 2) + "/" +
                                valor.substring(2);
                    }

                    input.value = valor;

                    if (valor.length === 10) {
                        if (validarFecha(valor, validarEdad)) {
                            input.style.color = "black";
                        } else {
                            input.style.color = "red";
                        }
                    } else {
                        input.style.color = "red";
                    }
                });
            }

            //cAMBIAR SINTAXIS
            function validarFecha(texto, validarEdad) {
                const partes = texto.split("/");
                if (partes.length !== 3) return false;

                const dia = parseInt(partes[0]);
                const mes = parseInt(partes[1]);
                const año = parseInt(partes[2]);

                const fecha = new Date(año, mes - 1, dia);

                // Fecha real
                if (fecha.getFullYear() !== año ||
                    fecha.getMonth() !== mes - 1 ||
                    fecha.getDate() !== dia) {
                    return false;
                }

                //VALIDACION FECHA DEMANDA
                if (!validarEdad) {
                    const hoy = new Date();
                    hoy.setHours(0, 0, 0, 0);

                    const fechaIngresada = new Date(año, mes - 1, dia);

                    if (fechaIngresada > hoy) return false;

                    return true;
                }

                //VALIDACIONF ECHA NACIMIENTO
                const hoy = new Date();
                let edad = hoy.getFullYear() - año;

                const cumpleEsteAño = new Date(hoy.getFullYear(), mes - 1, dia);
                if (hoy < cumpleEsteAño) edad--;

                return edad >= 16 && edad <= 80;
            }

            configurarFecha("FechaNacimiento", true);
            configurarFecha("FechaDemanda", false);

            //BLOQUEAR SI ALS FECHAS NO CUMPLEN LOS PARAMETROS
            document.querySelector("form").addEventListener("submit", function (e) {

                const fn = document.getElementById("FechaNacimiento").value.trim();
                const fd = document.getElementById("FechaDemanda").value.trim();

                if (!validarFecha(fn, true)) {
                    e.preventDefault();
                    alert("La fecha de nacimiento no es válida. Debe tener entre 16 y 80 años.");
                    return;
                }

                if (!validarFecha(fd, false)) {
                    e.preventDefault();
                    alert("La fecha de demanda no puede ser posterior al día de hoy.");
                    return;
                }
            });
    </script>

    <script>
            //VALIDAR TELEFONOS
            function configurarTelefono(idCampo) {
                const input = document.getElementById(idCampo);

                input.addEventListener("input", function () {

                    const oldValue = input.getAttribute("data-old") || "";
                    const newValue = input.value;

                    const borrando = newValue.length < oldValue.length;
                    input.setAttribute("data-old", newValue);

                    if (borrando) {
                        input.style.color = "red";
                        return;
                    }

                    let valor = newValue.replace(/\D/g, "");

                    if (valor.length > 9)
                        valor = valor.substring(0, 9);

                    if (valor.length >= 7) {
                        valor = valor.substring(0, 3) + " " +
                                valor.substring(3, 5) + " " +
                                valor.substring(5, 7) + " " +
                                valor.substring(7);
                    }
                    else if (valor.length >= 5) {
                        valor = valor.substring(0, 3) + " " +
                                valor.substring(3, 5) + " " +
                                valor.substring(5);
                    }
                    else if (valor.length >= 3) {
                        valor = valor.substring(0, 3) + " " +
                                valor.substring(3);
                    }

                    input.value = valor;

                    if (valor.length === 12) {
                        input.style.color = "black";
                    } else {
                        input.style.color = "red";
                    }
                });
            }

            configurarTelefono("Telefono1");
            configurarTelefono("Telefono2");

            //VALIDACION REAL DEL TELEFONO
            function telefonoValido(tel) {
                const regex = /^[0-9]{3} [0-9]{2} [0-9]{2} [0-9]{2}$/;
                return regex.test(tel.trim());
            }

            //BLOQUEAR SI EL TELEFONO NO CUMPLE LOS REQUESITOS
            document.querySelector("form").addEventListener("submit", function (e) {

                const tel = document.getElementById("Telefono1").value;

                if (!telefonoValido(tel)) {
                    e.preventDefault();
                    alert("El teléfono introducido no tiene un formato válido.");
                    return;
                }
            });
    </script>

    <script>
        //PUESSTOS SOLICITADOS
            function mostrarAlertaDuplicado() {
                const alerta = document.createElement("div");
                alerta.innerHTML = `
                    <div style="
                        position: fixed;
                        top: 50%;
                        left: 50%;
                        transform: translate(-50%, -50%);
                        background: white;
                        padding: 25px;
                        border-radius: 10px;
                        box-shadow: 0 0 15px rgba(0,0,0,0.3);
                        z-index: 9999;
                        width: 90%;
                        max-width: 400px;
                        text-align: center;
                        font-family: Arial;
                    ">
                        <h5 style="color:#c89de0; font-weight:bold;">Profesión duplicada</h5>
                        <p>No se puede elegir la misma profesión dos veces.</p>
                        <button id="cerrarAlerta" style="
                            background:#c89de0;
                            color:white;
                            border:none;
                            padding:8px 15px;
                            border-radius:5px;
                            margin-top:10px;
                        ">Aceptar</button>
                    </div>
                `;
                document.body.appendChild(alerta);

                document.getElementById("cerrarAlerta").onclick = () => alerta.remove();
            }

            //VALIDACION DE PROFESIONES DUPLICADAS
            function validarProfesionesDuplicadas() {
                const selects = document.querySelectorAll(".puesto-picker");
                const valores = new Set();
                let hayDuplicados = false;

                selects.forEach(sel => {
                    const val = sel.value;

                    if (!val || sel.selectedIndex === 0) {
                        sel.style.border = "";
                        return;
                    }

                    if (valores.has(val)) {
                        sel.style.border = "2px solid red";
                        hayDuplicados = true;
                    } else {
                        sel.style.border = "";
                        valores.add(val);
                    }
                });

                if (hayDuplicados) {
                    mostrarAlertaDuplicado();
                    return false;
                }

                return true;
            }

            document.addEventListener("change", function (e) {
                if (e.target.classList.contains("puesto-picker")) {
                    validarProfesionesDuplicadas();
                }
            });

            //VALIDACIÓN COMPLETA ANTES DE ENVIAR
                        function validarAntesDeEnviar() {
                const filas = document.querySelectorAll(".puesto-row");
                let hayAlMenosUna = false;

                // Validar duplicados
                if (!validarProfesionesDuplicadas()) return false;

                for (let fila of filas) {
                    const categoria = fila.querySelector(".categoria-picker").value.trim();
                    const puesto = fila.querySelector(".puesto-picker").value.trim();

                    //Categoría sin puesto
                    if (categoria && !puesto) {
                        alert("Has seleccionado una categoría sin elegir un puesto.");
                        return false;
                    }

                    //Puesto sin categoría
                    if (!categoria && puesto) {
                        alert("Has seleccionado un puesto sin elegir una categoría.");
                        return false;
                    }

                    //Fila completamente vacía
                    if (!categoria && !puesto) {
                        alert("No puedes dejar filas vacías. Elimina la fila o selecciona categoría y puesto.");
                        return false;
                    }

                    //Fila completa y correcta
                    if (categoria && puesto) {
                        hayAlMenosUna = true;
                    }
                }

                // Caso 5: No hay ninguna fila completa
                if (!hayAlMenosUna) {
                    alert("Debes seleccionar al menos una categoría y un puesto.");
                    return false;
                }

                return true;
            }

            document.querySelector("form").addEventListener("submit", function (e) {
                if (!validarAntesDeEnviar()) e.preventDefault();
            });


            //ACTIVAR PICKERS
                        function activarPickers(fila) {
                const categoriaSelect = fila.querySelector(".categoria-picker");
                const puestoSelect = fila.querySelector(".puesto-picker");

                categoriaSelect.addEventListener("change", function () {
                    const idCategoria = this.value;

                    puestoSelect.value = "";

                    puestoSelect.innerHTML = '<option value="">Cargando...</option>';

                    if (!idCategoria) {
                        puestoSelect.innerHTML = '<option value="">Seleccione un puesto</option>';
                        return;
                    }

                    fetch(`/Formulario?handler=Profesiones&idCategoria=${idCategoria}`)
                        .then(response => response.json())
                        .then(data => {
                            puestoSelect.innerHTML = '<option value="">Seleccione un puesto</option>';
                            data.forEach(p => {
                                const option = document.createElement("option");
                                option.value = p.id;
                                option.textContent = p.nombre;
                                puestoSelect.appendChild(option);
                            });
                        });
                });
            }

            document.querySelectorAll(".puesto-row").forEach(fila => activarPickers(fila));

            const contenedor = document.getElementById("contenedor-puestos");
            const btnAñadir = document.getElementById("btnAñadir");
            const btnEliminar = document.getElementById("btnEliminar");

            //AÑADIR FILA
            btnAñadir.addEventListener("click", () => {
                const filas = contenedor.querySelectorAll(".puesto-row").length;
                if (filas >= 6) return;

                const nuevaFila = contenedor.querySelector(".puesto-row").cloneNode(true);

                nuevaFila.querySelector(".categoria-picker").value = "";
                const nuevoPuesto = nuevaFila.querySelector(".puesto-picker");
                nuevoPuesto.innerHTML = '<option value="">Seleccione un puesto</option>';
                nuevoPuesto.value = "";

                contenedor.appendChild(nuevaFila);
                activarPickers(nuevaFila);
            });

            //ELIMINAR FILA
            btnEliminar.addEventListener("click", () => {
                const filas = contenedor.querySelectorAll(".puesto-row");
                if (filas.length > 1) filas[filas.length - 1].remove();
            });
    </script>
</div>